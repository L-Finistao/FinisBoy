# Neon: Dashboard > Connection Details > Connection string (com sslmode=require)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Segredo do login (texto longo e aleatório). Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo
# Opcional: se preencher, só cria conta quem souber este código
SIGNUP_CODE=
